# Server
PORT=5000
NODE_ENV=development

# Set to true to disable Swagger, WebSocket, and test routes for load benchmarks
BENCHMARK_MODE=false

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/rate-limiter

# Redis — use local for benchmarks; Upstash/cloud for deploys
REDIS_URL=redis://127.0.0.1:6379
# REDIS_URL=rediss://default:TOKEN@endpoint.upstash.io:6379

# Auth
ADMIN_JWT_SECRET=change-me-in-production

# Swagger
API_URL=http://localhost:5000

# Logging
LOG_LEVEL=info
